# Copy to .env.local for local `npm run dev`. Never commit the real file.
#
# Get these from the Ostrovok B2B / RateHawk partner cabinet
# (account.b2b.ostrovok.ru → your contract → API access, or partner.ratehawk.com).
# The site works fine with demo data until these are set.

OSTROVOK_KEY_ID=
OSTROVOK_API_KEY=

# "sandbox" (default, safe to test with) or "production"
OSTROVOK_ENV=sandbox

# ISO 3166-1 alpha-2 traveller residency sent on every search (lowercase)
OSTROVOK_RESIDENCY=ru

# ISO 4217 currency requested from the API
OSTROVOK_CURRENCY=USD

# Max hotels enriched + returned per search
OSTROVOK_MAX_RESULTS=24
