{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "moscowa",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "OSTROVOK_ENV": "sandbox",
    "OSTROVOK_RESIDENCY": "ru",
    "OSTROVOK_CURRENCY": "USD",
    "OSTROVOK_MAX_RESULTS": "24"
  },
  "d1_databases": [
    {
      "binding": "OSTROVOK_DB",
      "database_name": "ostrovok-db",
      "database_id": "aa62f9cf-795f-4532-9123-c884debb2d11",
      "experimental_remote": true
    }
  ]
}
